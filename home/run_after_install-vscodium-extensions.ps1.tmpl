{{- if eq .chezmoi.os "windows" -}}
{{- $manifest := include "../VSCODIUM_EXTENSIONS.json" | fromJson -}}
$ErrorActionPreference = 'Stop'
$cli = Get-Command codium, vscodium -CommandType Application -ErrorAction SilentlyContinue |
    Select-Object -First 1
if (-not $cli) {
    throw 'VSCodium CLI is required; install it before applying extensions.'
}
Set-Location -LiteralPath $env:USERPROFILE

function Get-InstalledExtensions {
    $listed = @(& $cli.Source --list-extensions)
    if ($LASTEXITCODE -ne 0) {
        throw 'Could not list VSCodium extensions.'
    }
    $listed | ForEach-Object { $_.Trim().ToLowerInvariant() }
}

$installed = @(Get-InstalledExtensions)
$keep = @(
{{- range $manifest.install }}
    '{{ . | replace "'" "''" }}'
{{- end }}
{{- range $manifest.manual }}
    '{{ . | replace "'" "''" }}'
{{- end }}
)
$extensions = @(
{{- range $manifest.install }}
    '{{ . | replace "'" "''" }}'
{{- end }}
)

function Confirm-YesNo {
    param([string]$Question, [bool]$WhenNoTty)
    if ([Console]::IsInputRedirected) {
        return $WhenNoTty
    }
    $answer = Read-Host "$Question [Y/n]"
    if ($answer -match '^[nN]') {
        return $false
    }
    return $true
}

$extras = @($installed | Where-Object { $keep -notcontains $_ } | Sort-Object)
if ($extras.Count -gt 0 -and -not [Console]::IsInputRedirected) {
    Write-Host 'These extensions will be uninstalled:'
    foreach ($extension in $extras) {
        Write-Host "  $extension"
    }
    if (Confirm-YesNo 'Uninstall these extensions?' $false) {
        foreach ($extension in $extras) {
            Write-Host "dotfiles: uninstalling VSCodium extension: $extension"
            & $cli.Source --uninstall-extension $extension
            if ($LASTEXITCODE -ne 0) {
                Write-Host "dotfiles: could not uninstall $extension"
            }
        }
    }
}

$missing = @($extensions | Where-Object { $installed -notcontains $_ })
if ($missing.Count -gt 0 -and -not [Console]::IsInputRedirected) {
    Write-Host 'These extensions will be installed:'
    foreach ($extension in $missing) {
        Write-Host "  $extension"
    }
    if (-not (Confirm-YesNo 'Install these extensions?' $true)) {
        $missing = @()
    }
}

$installedCount = 0
foreach ($extension in $missing) {
    Write-Host "dotfiles: installing VSCodium extension: $extension"
    & $cli.Source --install-extension $extension
    if ($LASTEXITCODE -ne 0) {
        throw "Failed to install $extension; rerun after fixing the error."
    }
    $installedCount++
}

$installed = @(Get-InstalledExtensions)
foreach ($extension in $extensions) {
    if ($installed -notcontains $extension -and $installedCount -gt 0) {
        throw "Extension missing after installation: $extension"
    }
}
if ($installedCount -gt 0) {
    Write-Host "dotfiles: VSCodium extensions verified ($installedCount installed)."
}
{{ end -}}
