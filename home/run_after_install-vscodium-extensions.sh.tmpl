{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{- $manifest := include "../VSCODIUM_EXTENSIONS.json" | fromJson -}}
#!/bin/sh
set -u

# Extensions are user state, and gallery or network hiccups must never fail
# the Chezmoi apply: failures are logged, retried once per apply and reported.
if [ "$(id -u)" = 0 ]; then
    printf '%s\n' 'dotfiles: run VSCodium extension setup as your normal user, not root.' >&2
    exit 1
fi

if [ -n "${NIMBUS_INSTALL_LOG_DIR:-}" ] && [ -d "$NIMBUS_INSTALL_LOG_DIR" ] && [ ! -L "$NIMBUS_INSTALL_LOG_DIR" ]; then
    log_dir=$NIMBUS_INSTALL_LOG_DIR
else
    log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles
fi
if (umask 077; mkdir -p "$log_dir") 2>/dev/null; then
    log=$log_dir/vscodium-extensions.log
else
    log=/dev/null
fi

cli=$(command -v codium || command -v vscodium) || {
    printf '%s\n' 'dotfiles: VSCodium CLI is not installed; skipping extension setup.' >&2
    exit 0
}
cd "$HOME"

list_extensions() {
    if ! listed=$("$cli" --list-extensions 2>>"$log"); then
        return 1
    fi
    printf '%s\n' "$listed" | tr -d '\r' | tr '[:upper:]' '[:lower:]'
}

installed=$(list_extensions) || {
    printf '%s\n' "dotfiles: could not list VSCodium extensions; skipping. See $log" >&2
    exit 0
}
keep=$(printf '%s\n'{{ range $manifest.install }} \
    {{ . | shellQuote }}{{ end }}{{ range $manifest.manual }} \
    {{ . | shellQuote }}{{ end }})
set --{{ range $manifest.install }} \
    {{ . | shellQuote }}{{ end }}

# A flaky marketplace response gets bounded retries with linear backoff;
# DOTFILES_RETRY_DELAY shortens the wait in tests.
retry_delay=${DOTFILES_RETRY_DELAY:-5}
install_extension() {
    extension=$1
    attempt=1
    while [ "$attempt" -le 3 ]; do
        if "$cli" --install-extension "$extension" >>"$log" 2>&1; then
            return 0
        fi
        printf 'dotfiles: attempt %d failed for %s; retrying in %ds.\n' \
            "$attempt" "$extension" "$((attempt * retry_delay))" >&2
        sleep "$((attempt * retry_delay))"
        attempt=$((attempt + 1))
    done
    return 1
}

print_names() {
    printf '%s\n' "$1"
    shift
    for name do
        printf '  %s\n' "$name"
    done
}

confirm() {
    # Usage: confirm "Question?" yes|no   (yes|no is the no-tty default)
    if [ ! -t 0 ]; then
        [ "$2" = yes ]
        return $?
    fi
    printf '%s [Y/n] ' "$1"
    read -r reply || return 1
    case $reply in
        [nN]|[nN][oO]) return 1 ;;
        *) return 0 ;;
    esac
}

extras=$(
    printf '%s\n' "$installed" | while IFS= read -r extension; do
        [ -n "$extension" ] || continue
        if ! printf '%s\n' "$keep" | grep -Fqx -- "$extension"; then
            printf '%s\n' "$extension"
        fi
    done
)
if [ -n "$extras" ] && [ -t 0 ]; then
    # shellcheck disable=SC2086
    print_names "These extensions will be uninstalled:" $extras
    if confirm "Uninstall these extensions?" no; then
        printf '%s\n' "$extras" | while IFS= read -r extension; do
            [ -n "$extension" ] || continue
            printf 'dotfiles: uninstalling VSCodium extension: %s\n' "$extension"
            if ! "$cli" --uninstall-extension "$extension" >>"$log" 2>&1; then
                printf 'dotfiles: could not uninstall %s; see %s\n' "$extension" "$log" >&2
            fi
        done
    fi
fi

installed_count=0
failed_count=0
missing=
for extension do
    if printf '%s\n' "$installed" | grep -Fqx -- "$extension"; then
        continue
    fi
    missing="$missing $extension"
done
if [ -n "$missing" ]; then
    # shellcheck disable=SC2086
    if [ -t 0 ]; then
        print_names "These extensions will be installed:" $missing
        if ! confirm "Install these extensions?" yes; then
            missing=
        fi
    fi
    for extension in $missing; do
        printf 'dotfiles: installing VSCodium extension: %s\n' "$extension"
        if install_extension "$extension"; then
            installed_count=$((installed_count + 1))
        else
            failed_count=$((failed_count + 1))
            printf 'dotfiles: could not install %s; the next nimbus sync retries.\n' "$extension" >&2
        fi
    done
fi

installed=$(list_extensions) || installed=
missing_count=0
for extension do
    if ! printf '%s\n' "$installed" | grep -Fqx -- "$extension"; then
        missing_count=$((missing_count + 1))
    fi
done
if [ "$failed_count" -gt 0 ] || [ "$missing_count" -gt 0 ]; then
    printf 'dotfiles: VSCodium extensions incomplete (%s installed, %s failed, %s missing); see %s\n' \
        "$installed_count" "$failed_count" "$missing_count" "$log" >&2
    exit 0
fi
if [ "$installed_count" -gt 0 ]; then
    printf 'dotfiles: VSCodium extensions verified (%s installed).\n' "$installed_count"
fi
{{ end -}}
