{{- /* Copy before setValueAtPath; it mutates the map in place. */ -}}
{{- $target := joinPath .chezmoi.homeDir ".claude/settings.json" -}}
{{- $local := dict -}}
{{- if stat $target -}}
{{-   $local = include $target | fromJsonc -}}
{{- end -}}
{{- $ask := list "Bash(git commit:*)" "Bash(git push:*)" "Bash(git tag:*)" "Bash(gh pr create:*)" -}}
{{- $new := $local | toJson | fromJson
  | setValueAtPath "permissions.defaultMode" "auto"
  | setValueAtPath "permissions.ask" $ask
  | setValueAtPath "permissions.deny" (list "Bash(sudo:*)")
  | setValueAtPath "autoMemoryEnabled" false -}}
{{- if and (stat $target) (eq ($local | toJson) ($new | toJson)) -}}
{{- include $target -}}
{{- else -}}
{{- $new | toPrettyJson -}}
{{- end -}}
