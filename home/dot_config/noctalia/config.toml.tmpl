# Reviewed Noctalia preferences. GUI overrides remain local and take precedence.
# Colors, credentials, discovered calendars and usage history remain unmanaged.
[theme]
source = "wallpaper"
wallpaper_scheme = "soft"
builtin = "Noctalia"
community_palette = "Oxocarbon"
mode = "dark"
shell_mode = "follow"
pure_black_dark = false

[theme.templates]
enable_builtin_templates = true
enable_community_templates = true
builtin_ids = ["btop", "gtk3", "gtk4", "ghostty", "hyprland", "kcolorscheme", "qt"]
community_ids = [
    "claude-code",
    "codex",
    "opencode",
    "discord",
    "libreoffice",
    "obsidian",
    "vscode",
    "zed",
    "heroiclauncher",
    "prismlauncher",
    "steam",
    "obs",
    "zathura",
    "hyprtoolkit",
    "papirus-icons",
    "bat",
    "fzf",
    "herdr",
    "lazygit",
    "yazi",
]

[wallpaper]
directory = "~/Pictures/Wallpapers"

[wallpaper.default]
{{ if and (hasKey . "Machine") (eq .Machine "desktop") -}}
path = "~/Pictures/Wallpapers/slate-rose-cathedral.png"
{{ else -}}
path = "/usr/share/noctalia/assets/noctalia-wallpaper.png"
{{ end -}}

[bar.default]
start = ["workspaces"]
center = ["clock", "date", "weather", "timer", "notifications"]
end = [
    "ai-usage",
    "tailnet",
    "recorder",
    "airpods",
    "battery",
    "drives",
    "tray",
    "volume",
    "control-center",
]
background_opacity = 0.80
font_family = "JetBrainsMono Nerd Font Propo"

[widget.workspaces]
label_source = "name"
show_all_outputs = false
hide_when_empty = false

[widget.ai-usage]
type = "felipeartur/ai-usagebar:bar"

[widget.tailnet]
type = "rylos/tailnet:bar"

[widget.timer]
type = "noctalia/timer:bar"
show_idle_on_horizontal = false

[widget.notifications]
hide_when_no_unread = true

[widget.weather]
show_condition = false

[widget.recorder]
type = "noctalia/screen_recorder:recorder"

[widget.airpods]
type = "harveywuk/airpods:airpods"

[widget.drives]
type = "aristides/udiskie:status"

[widget.tray]
detached_panel = true
drawer = true
hidden = ["Librepods"]

[widget.volume]
show_label = false

[widget.bluetooth]
hide_when_adapter_off = true

[widget.network]
show_label = false

[shell]
button_borders = false
card_borders = false
clipboard_auto_paste = "off"
font_family = "Inter"
input_borders = false
launch_apps_as_systemd_services = true
polkit_agent = true
popup_borders = false
screen_time_enabled = true
settings_window_translucent = true

[shell.screenshot]
directory = "~/Pictures/Screenshots"
save_to_file = true


[[shell.session.actions]]
action = "lock"
countdown_seconds = 0
enabled = true
shortcut = "l"
variant = "default"

[[shell.session.actions]]
action = "logout"
command = "loginctl terminate-session \"${XDG_SESSION_ID:?No graphical login session}\""
countdown_seconds = 0
enabled = true
shortcut = "x"
variant = "default"

[[shell.session.actions]]
action = "suspend"
countdown_seconds = 0
enabled = true
shortcut = "s"
variant = "default"

[[shell.session.actions]]
action = "reboot"
countdown_seconds = 0
enabled = true
shortcut = "r"
variant = "default"

[[shell.session.actions]]
action = "shutdown"
countdown_seconds = 0
enabled = true
shortcut = "p"
variant = "destructive"

[shell.launcher]
auto_paste = "off"
categories = false

[shell.panel]
control_center_placement = "floating"
open_near_click_clipboard = true
open_near_click_control_center = true
open_near_click_launcher = true
open_near_click_wallpaper = true
polkit_position = "auto"
session_placement = "floating"
session_position = "center"
transparency_mode = "glass"
wallpaper_placement = "floating"

[shell.window_switcher]
mru = true

[idle.behavior.lock]
timeout = 600
action = "lock"
enabled = true

[idle.behavior.screen-off]
timeout = 900
action = "screen_off"
enabled = true

[plugins]
enabled = [
    "noctalia/notes",
    "noctalia/screen_recorder",
    "noctalia/timer",
    "felipeartur/ai-usagebar",
    "harveywuk/airpods",
    "umedbazarov/crashes",
    "tphilippot/git_companion",
    "profidev/hypr-screen-mirror",
    "kenn/keybind-cheatsheet",
    "8bury/mini-docker",
    "rylos/tailnet",
    "aristides/udiskie",
    "rxtsel/portctl",
    "cleboost/ssh-launcher",
{{- if and (hasKey . "Machine") (eq .Machine "laptop") }}
    "8bury/lid-guard",
{{- end }}
]

[plugin_settings."umedbazarov/crashes"]
terminal_cmd = "ghostty --class=com.mitchellh.ghostty.presentation -e"
agent_cmd = "codex"
agent_order = "codex, claude, grok, opencode"
panel_open_near_click = true

[plugin_settings."8bury/mini-docker"]
manager_position = "auto"

[plugin_settings."aristides/udiskie"]
manager_open_near_click = true

[plugin_settings."felipeartur/ai-usagebar"]
panel_open_near_click = true
panel_placement = "floating"

[plugin_settings."harveywuk/airpods"]
panel_placement = "floating"
panel_position = "auto"

[plugin_settings."noctalia/notes"]
panel_position = "top_right"

[plugin_settings."noctalia/timer"]
panel_placement = "floating"

[plugin_settings."profidev/hypr-screen-mirror"]
panel_open_near_click = true
panel_position = "auto"

[plugin_settings."rylos/tailnet"]
panel_placement = "floating"

[plugin_settings."tphilippot/git_companion"]
main_placement = "floating"

[plugin_settings."noctalia/screen_recorder"]
directory = "~/Videos/Recordings"

[brightness]
{{ if and (hasKey . "Machine") (eq .Machine "desktop") -}}
enable_ddcutil = true
{{ end -}}
sync_all_monitors = true

[control_center.calendar]
show_week_numbers = true

[location]
auto_locate = true

# Match bar and terminal backgrounds; fade the dock only subtly when inactive.
[dock]
background_opacity = 0.80
active_opacity = 1.0
inactive_opacity = 0.98

[notification]
background_opacity = 0.80

[osd]
background_opacity = 0.80
position = "bottom_center"
position_vertical = "bottom_right"

{{ if get . "fastmailUsername" -}}
[calendar]
enabled = true

[calendar.account.fastmail]
type = "caldav"
provider = "custom"
server_url = "https://caldav.fastmail.com/dav/"
username = {{ .fastmailUsername | quote }}

{{ end -}}

# Shared appearance; positions use a 1920x1080 reference and scale with output height.
[lockscreen]
blurred_desktop = false
wallpaper = ""
blur_intensity = 0.35
tint_intensity = 0.2

{{ $outputs := list "" -}}
{{ if eq (get . "Machine") "desktop" -}}
{{ $outputs = list "DP-3" "DP-4" -}}
{{ else if eq (get . "Machine") "laptop" -}}
{{ $outputs = list "eDP-1" -}}
{{ end -}}
[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [
{{ range $output := $outputs -}}
{{ if $output }}    "lockscreen-login-box@{{ $output }}",
{{ end }}    "minimal-date-{{ $output }}",
    "minimal-clock-{{ $output }}",
    "minimal-avatar-{{ $output }}",
{{ end -}}
]

[lockscreen_widgets.grid]
cell_size = 16
major_interval = 4
visible = false

{{ range $output := $outputs -}}
{{ if $output -}}
[lockscreen_widgets.widget."lockscreen-login-box@{{ $output }}"]
type = "login_box"
output = {{ $output | quote }}
cx = 960.0
cy = 745.0
box_width = 400.0
box_height = 70.0
placement_width = 1920.0
placement_height = 1080.0
rotation = 0.0

[lockscreen_widgets.widget."lockscreen-login-box@{{ $output }}".settings]
layout = "compact"
background_color = "surface_variant"
background_opacity = 0.0
background_radius = 12.0
input_opacity = 0.55
input_radius = 12.0
center_password_text = true
show_caps_lock = true
show_keyboard_layout = false
show_login_button = false
show_media = false
show_session_buttons = false
show_unlock_hint = false
show_weather = false

{{ end -}}
[lockscreen_widgets.widget."minimal-date-{{ $output }}"]
type = "clock"
output = {{ $output | quote }}
cx = 960.0
cy = 240.0
box_width = 440.0
box_height = 38.0
placement_width = 1920.0
placement_height = 1080.0
rotation = 0.0

[lockscreen_widgets.widget."minimal-date-{{ $output }}".settings]
clock_style = "digital"
format = "{:%A, %d %B}"
font_family = "Inter"
color = "#F5F5F7"
background = false
background_padding = 0.0
center_text = true
shadow = true

[lockscreen_widgets.widget."minimal-clock-{{ $output }}"]
type = "clock"
output = {{ $output | quote }}
cx = 960.0
cy = 330.0
box_width = 460.0
box_height = 140.0
placement_width = 1920.0
placement_height = 1080.0
rotation = 0.0

[lockscreen_widgets.widget."minimal-clock-{{ $output }}".settings]
clock_style = "digital"
format = "{:%H:%M}"
font_family = "Inter"
color = "#F5F5F7"
background = false
background_padding = 0.0
center_text = true
shadow = true

[lockscreen_widgets.widget."minimal-avatar-{{ $output }}"]
type = "sticker"
output = {{ $output | quote }}
cx = 960.0
cy = 654.0
box_width = 72.0
box_height = 72.0
placement_width = 1920.0
placement_height = 1080.0
rotation = 0.0

[lockscreen_widgets.widget."minimal-avatar-{{ $output }}".settings]
image_path = {{ joinPath $.chezmoi.homeDir ".config/noctalia/assets/profile-picture-circle.svg" | quote }}
opacity = 1.0
background = false
background_padding = 0.0

{{ end -}}

# Read the bindings file directly: plugin 0.2.7 misparses explicit Lua paths.
[plugin_settings."kenn/keybind-cheatsheet"]
hyprland_lua_config = "~/.config/hypr/conf.d/keybinds.lua"
hyprland_parser = "lua"
