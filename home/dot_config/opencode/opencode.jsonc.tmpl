{{- /* Copy before setValueAtPath; it mutates the map in place. */ -}}
{{- $target := joinPath .chezmoi.homeDir ".config/opencode/opencode.jsonc" -}}
{{- $local := dict -}}
{{- if stat $target -}}
{{-   $local = include $target | fromJsonc -}}
{{- end -}}
{{- $bash := dict "*" "allow" "rm -rf *" "ask" "git push *" "ask" "git reset --hard*" "ask" "sudo *" "ask" -}}
{{- $permission := dict "*" "allow" "bash" $bash "doom_loop" "ask" -}}
{{- $new := $local | toJson | fromJson | setValueAtPath "permission" $permission -}}
{{- if and (stat $target) (eq ($local | toJson) ($new | toJson)) -}}
{{- include $target -}}
{{- else -}}
{{- $new | toPrettyJson -}}
{{- end -}}
