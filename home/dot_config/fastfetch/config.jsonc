{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "default" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "default" }
  },
  "modules": [
    { "type": "custom", "format": "Hardware" },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "display",
    "battery",
    "break",
    { "type": "custom", "format": "Software" },
    "os",
    "kernel",
    "wm",
    "shell",
    "terminal",
    "packages",
    "uptime"
  ]
}
