{{- $signing := and (hasKey . "onePasswordSsh") .onePasswordSsh (has .chezmoi.os (list "linux" "darwin")) -}}
[user]
	useConfigOnly = true
{{- if $signing }}
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh" "github.pub" | quote }}
{{- end -}}
{{ if and (hasKey . "Machine") (or (eq .Machine "laptop") (eq .Machine "desktop")) }}
	email = pby.accounts@byrne.dk
	name = Patrick Byrne
{{- end }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	# Diverged branches need an explicit merge or rebase decision.
	ff = only

[push]
	autoSetupRemote = true
	followTags = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[rebase]
	autoSquash = true
	updateRefs = true
	missingCommitsCheck = error

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[help]
	autocorrect = prompt

[commit]
	verbose = true

[alias]
	st = status --short --branch
	lg = log --graph --oneline --decorate --all
{{ if $signing }}
[gpg]
	format = ssh

[gpg "ssh"]
{{ if eq .chezmoi.os "linux" -}}
	program = /opt/1Password/op-ssh-sign
{{ else -}}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{ end }}
[commit]
	gpgsign = true
{{ end -}}
