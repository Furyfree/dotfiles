[user]
	useConfigOnly = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	# Diverged branches need an explicit merge or rebase decision.
	ff = only

[push]
	autoSetupRemote = true

[merge]
	conflictStyle = zdiff3

[alias]
	st = status --short --branch
	lg = log --graph --oneline --decorate --all
