-- Monitor modes, scaling, positions, and output-specific settings.
-- Other machines and unlisted outputs keep automatic settings.
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})
{{ if and (hasKey . "Machine") (eq .Machine "desktop") }}
-- Desktop: BenQ XL2720Z is the main display; ZOWIE XL LCD is to its right.
hl.monitor({
    output = "DP-4",
    mode = "1920x1080@144",
    position = "0x0",
    scale = 1,
})
hl.monitor({
    output = "DP-3",
    mode = "1920x1080@144",
    position = "1920x0",
    scale = 1,
})
hl.config({ cursor = { default_monitor = "DP-4" } })
{{ end -}}
{{ if and (hasKey . "Machine") (eq .Machine "laptop") }}
-- Laptop: the 2880x1800 internal panel uses a 1920x1200 logical workspace.
hl.monitor({
    output = "eDP-1",
    mode = "preferred",
    position = "auto",
    scale = 1.5,
})
{{ end -}}
