-- 3. Column size and fullscreen
hl.bind(
    mainMod .. " + R",
    hl.dsp.layout("colresize +conf"),
    { description = "Cycle column width" }
)
hl.bind(
    mainMod .. " + C",
    hl.dsp.layout("center"),
    { description = "Center column" }
)
hl.bind(
    mainMod .. " + F",
    function()
        local window = hl.get_active_window()
        local layout = window and window.layout
        if not layout or layout.name ~= "scrolling" or not layout.column then
            return
        end

        local width = layout.column.width >= 1.0 and "0.5" or "1.0"
        hl.dispatch(hl.dsp.layout("colresize " .. width))
    end,
    { description = "Toggle half/full column width" }
)
hl.bind(
    mainMod .. " + SHIFT + Return",
    hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }),
    { description = "Toggle fullscreen" }
)

