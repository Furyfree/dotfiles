{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
set -euo pipefail

user_id=$(id -u)
if [ "$user_id" = 0 ]; then
    printf '%s\n' 'dotfiles: run chezmoi apply as your normal user, not root.' >&2
    exit 1
fi

mise_config_dir="$HOME/.config/mise"
if [ ! -r "$mise_config_dir/config.toml" ]; then
    printf '%s\n' "dotfiles: missing Mise configuration: $mise_config_dir/config.toml" >&2
    exit 1
fi

mise_binary="$HOME/.local/bin/mise"
if [ ! -x "$mise_binary" ]; then
    mise_binary=$(command -v mise) || {
        printf '%s\n' 'dotfiles: Mise is required; install Mise, then rerun chezmoi apply.' >&2
        exit 1
    }
fi

printf '%s\n' 'dotfiles: installing configured Mise runtimes and tools'
{{ if get . "ManagedByNimbus" -}}
printf '%s\n' 'Setup note: Open a new terminal after installation to load the shell and Mise configuration.'
if command -v 1password >/dev/null 2>&1 || command -v op >/dev/null 2>&1; then
    printf '%s\n' 'Setup note: 1Password: open the desktop app, sign in and unlock it. Enable "Integrate with 1Password CLI" in Settings > Developer.'
{{ if get . "onePasswordSsh" -}}
    printf '%s\n' 'Setup note: 1Password SSH: enable the SSH agent in Settings > Developer and keep the desktop app running.'
{{ else -}}
    printf '%s\n' 'Setup note: 1Password SSH is not enabled in dotfiles. Follow the 1Password SSH section of the dotfiles README before opting in.'
{{ end -}}
fi
{{ if and (hasKey . "profiles") (has "hyprland-noctalia" .profiles) -}}
printf '%s\n' 'Setup note: Noctalia: the desktop profile selects theme integrations. Log into the desktop to generate colors; see NOCTALIA.md for app prerequisites and existing GUI overrides.'
printf '%s\n' 'Setup note: Brave Origin: select Use GTK in Settings > Appearance to follow the Noctalia GTK theme.'
{{ end -}}
{{ end -}}
cd "$HOME"
export MISE_CONFIG_DIR="$mise_config_dir"
# Do not load project/version files from the home directory or its parents.
export MISE_CEILING_PATHS="$HOME"
# Selecting an individual global file would skip the Linux tools fragment.
unset MISE_GLOBAL_CONFIG_FILE
export MISE_SYSTEM_DEPS=warn
export MISE_AUTO_UPDATE=false

# Nimbus supplies a private per-run directory. Keep secret-bearing Chezmoi
# output outside this log; only these native Mise commands enter it.
mise_log=
if [[ -n ${NIMBUS_INSTALL_LOG_DIR:-} ]]; then
    if [[ $NIMBUS_INSTALL_LOG_DIR != /* || -L $NIMBUS_INSTALL_LOG_DIR ||
          ! -d $NIMBUS_INSTALL_LOG_DIR ||
          $(stat -c '%u:%a' -- "$NIMBUS_INSTALL_LOG_DIR") != "$user_id:700" ]]; then
        printf '%s\n' 'dotfiles: Nimbus installation log directory must be private and owned by this user.' >&2
        exit 1
    fi
    mise_log="$NIMBUS_INSTALL_LOG_DIR/mise.log"
    if [[ -e $mise_log || -L $mise_log ]]; then
        if [[ -L $mise_log || ! -f $mise_log ||
              $(stat -c '%u:%a:%h' -- "$mise_log") != "$user_id:600:1" ]]; then
            printf '%s\n' 'dotfiles: refusing an unsafe Mise installation log.' >&2
            exit 1
        fi
    else
        # noclobber also refuses a symlink created after the existence check.
        (umask 077; set -C; : > "$mise_log") || {
            printf '%s\n' 'dotfiles: cannot create the private Mise installation log.' >&2
            exit 1
        }
    fi
fi

run_mise() {
    local started=$SECONDS status=0
    local -a command_status
    if [[ -z $mise_log ]]; then
        "$mise_binary" -C "$HOME" "$@"
        return
    fi
    {
        printf '%s command:' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf ' %q' mise "$@"
        printf '\n'
    } >> "$mise_log"
    if "$mise_binary" -C "$HOME" "$@" 2>&1 | tee -a -- "$mise_log"; then
        status=0
    else
        command_status=("${PIPESTATUS[@]}")
        status=${command_status[0]}
        if ((command_status[1] != 0)); then
            printf '%s\n' 'dotfiles: cannot write the Mise installation log.' >&2
            if ((status == 0)); then status=${command_status[1]}; fi
        fi
    fi
    printf '%s exit=%s duration=%ss\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$status" "$((SECONDS - started))" >> "$mise_log"
    return "$status"
}

run_mise install
{{ end -}}
