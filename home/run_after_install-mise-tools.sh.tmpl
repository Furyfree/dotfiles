{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -eu

user_id=$(id -u)
if [ "$user_id" = 0 ]; then
    printf '%s\n' 'dotfiles: run chezmoi apply as your normal user, not root.' >&2
    exit 1
fi

mise_config_dir="$HOME/.config/mise"
if [ ! -r "$mise_config_dir/config.toml" ]; then
    printf '%s\n' "dotfiles: missing Mise configuration: $mise_config_dir/config.toml" >&2
    exit 1
fi

mise_binary="$HOME/.local/bin/mise"
if [ ! -x "$mise_binary" ]; then
    mise_binary=$(command -v mise) || {
        printf '%s\n' 'dotfiles: Mise is required; install Mise, then rerun chezmoi apply.' >&2
        exit 1
    }
fi

printf '%s\n' 'dotfiles: installing configured Mise runtimes and tools'
{{ if get . "ManagedByNimbus" -}}
printf '%s\n' 'Setup note: Open a new terminal after installation to load the shell and Mise configuration.'
if command -v 1password >/dev/null 2>&1 || command -v op >/dev/null 2>&1; then
    printf '%s\n' 'Setup note: 1Password: open the desktop app, sign in and unlock it. Enable "Integrate with 1Password CLI" in Settings > Developer.'
{{ if get . "onePasswordSsh" -}}
    printf '%s\n' 'Setup note: 1Password SSH: enable the SSH agent in Settings > Developer and keep the desktop app running.'
{{ else -}}
    printf '%s\n' 'Setup note: 1Password SSH is not enabled in dotfiles. Follow the 1Password SSH section of the dotfiles README before opting in.'
{{ end -}}
fi
{{ if and (hasKey . "profiles") (has "hyprland-noctalia" .profiles) -}}
printf '%s\n' 'Setup note: Noctalia: choose and generate its theme in the GUI before opening Ghostty.'
{{ end -}}
{{ end -}}
cd "$HOME"
export MISE_CONFIG_DIR="$mise_config_dir"
# Do not load project/version files from the home directory or its parents.
export MISE_CEILING_PATHS="$HOME"
# Selecting an individual global file would skip the Cargo config fragment.
unset MISE_GLOBAL_CONFIG_FILE
export MISE_SYSTEM_DEPS=warn
export MISE_AUTO_UPDATE=false
exec "$mise_binary" -C "$HOME" install
{{ end -}}
