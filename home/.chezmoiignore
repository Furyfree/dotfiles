{{- $profiles := list "common" -}}
{{- if hasKey . "profiles" -}}
{{-   $profiles = .profiles -}}
{{- end -}}
{{- $hyprlandNoctalia := has "hyprland-noctalia" $profiles -}}
{{- $niriDms := has "niri-dms" $profiles -}}
{{- $onePasswordSsh := false -}}
{{- if hasKey . "onePasswordSsh" -}}
{{-   $onePasswordSsh = .onePasswordSsh -}}
{{- end -}}

# Completed files are managed by default. These rules select platforms/profiles
# and exclude optional actions, generated files, references, and empty scaffolds.

# Platform target trees
{{ if ne .chezmoi.os "windows" -}}
AppData/**
Documents/**
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
Library/**
{{ end -}}

# Mixed root and .config targets
{{ if eq .chezmoi.os "windows" -}}
.zshenv
.profile
.bash_profile
.bashrc
.bash_logout
.blerc
.config/1Password/**
.config/VSCodium/**
.config/bash/**
.config/btop/**
.config/gh/**
.config/ghostty/**
.config/mise/**
.config/nix/**
.config/nvim/**
.config/sheldon/**
.config/topgrade.toml
.config/zed/**
.config/zsh/**
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
.config/VSCodium/**
{{ end -}}

# Hyprland and Noctalia targets
{{ if or (ne .chezmoi.os "linux") (not $hyprlandNoctalia) -}}
.config/hypr/**
.config/noctalia/**
.config/mimeapps.list
.config/gtk-3.0/settings.ini
.config/gtk-3.0/bookmarks
.config/gtk-4.0/settings.ini
.config/qt5ct/qt5ct.conf
.config/qt6ct/qt6ct.conf
.config/zsh/conf.d/noctalia.zsh
.config/bash/conf.d/noctalia.bash
{{ end -}}

# Other Linux user targets
{{ if ne .chezmoi.os "linux" -}}
.config/fastfetch/fedora-dot-colon.txt
.config/mise/conf.d
.config/mise/conf.d/linux-tools.toml
.config/udiskie/**
.config/user-dirs.dirs
.config/vm-curator/**
.config/voxtype/**
.config/zathura/**
.local/**
{{ end -}}

# Zeron's native installation supplies these assets; no app state is managed.
{{ if or (ne .chezmoi.os "linux") (not (has "development" $profiles)) -}}
.local/share/applications/zeron.desktop
.local/share/icons/hicolor/512x512/apps/zeron.png
{{ end -}}

# Niri and DankMaterialShell are a separate opt-in Linux session.
{{ if or (ne .chezmoi.os "linux") (not $niriDms) -}}
.config/niri/**
.config/DankMaterialShell/**
{{ end -}}

# Only Nimbus-dependent launchers need this gate, not the entire .local tree.
{{ if not (and (hasKey . "ManagedByNimbus") .ManagedByNimbus) -}}
.local/share/applications/GoogleMaps.desktop
.local/share/applications/FotMob.desktop
.local/share/icons/hicolor/512x512/apps/nimbus-webapp-*.png
{{ end -}}

# Reference notes and shell-generated palettes do not belong to Chezmoi.
.config/hypr/compare/**
.config/ghostty/themes/noctalia
.config/zed/themes/**
AppData/Roaming/Zed/themes/**

# Optional 1Password SSH integration; Windows remains deferred.
{{ if or (not $onePasswordSsh) (not (has .chezmoi.os (list "linux" "darwin"))) -}}
.ssh
.ssh/config
.ssh/github.pub
.ssh/homelab.pub
.config/1Password/**
{{ end -}}

# Git's personal settings remain unmanaged; shared defaults use .config/git/.
.gitconfig
.gitignore

# Placeholder files remain unmanaged until their config slice is implemented.
**/.keep
AppData/Local
Documents
.profile
.bash_logout
.config/VSCodium/User/snippets/**
.config/bash/logout
.config/ghostty/themes/dankcolors
.local/share/backgrounds/**
AppData/Local/1Password/**
AppData/Local/nvim/**
AppData/Roaming/VSCodium/User/snippets/**
AppData/Roaming/topgrade.toml
Documents/PowerShell/**
Library/Application Support/VSCodium/User/snippets/**

# Linux desktop folders and project checkout links.
{{ if or (ne .chezmoi.os "linux") (not $hyprlandNoctalia) -}}
Projects/**
Pictures/**
Videos/**
{{ end -}}
{{ if not (and (hasKey . "ManagedByNimbus") .ManagedByNimbus) -}}
Projects/nimbus
{{ end -}}
