{{- $profiles := list "common" -}}
{{- if hasKey . "profiles" -}}
{{-   $profiles = .profiles -}}
{{- end -}}
{{- $hyprlandNoctalia := has "hyprland-noctalia" $profiles -}}
{{- $niriDms := has "niri-dms" $profiles -}}
{{- $onePasswordSsh := false -}}
{{- if hasKey . "onePasswordSsh" -}}
{{-   $onePasswordSsh = .onePasswordSsh -}}
{{- end -}}

# Platform target trees
{{ if ne .chezmoi.os "windows" -}}
AppData/**
Documents/**
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
Library/**
{{ end -}}

# Mixed root and .config targets
{{ if eq .chezmoi.os "windows" -}}
.zshenv
.profile
.bash_profile
.bashrc
.bash_logout
.blerc
.config/1Password/**
.config/VSCodium/**
.config/bash/**
.config/btop/**
.config/gh/**
.config/ghostty/**
.config/mise/**
.config/nix/**
.config/nvim/**
.config/sheldon/**
.config/topgrade.toml
.config/zed/**
.config/zsh/**
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
.config/VSCodium/**
{{ end -}}

# Hyprland and Noctalia targets
{{ if or (ne .chezmoi.os "linux") (not $hyprlandNoctalia) -}}
.config/hypr/**
.config/noctalia/**
{{ end -}}

# Other Linux user targets
{{ if ne .chezmoi.os "linux" -}}
.config/mise/conf.d
.config/mise/conf.d/cargo.toml
.config/udiskie/**
.config/vm-curator/**
.config/zathura/**
.local/share/applications/**
.local/share/backgrounds/**
.local/share/icons/**
{{ end -}}

# Niri and DankMaterialShell are a separate opt-in Linux session.
{{ if or (ne .chezmoi.os "linux") (not $niriDms) -}}
.config/niri/**
.config/DankMaterialShell/**
{{ end -}}

# VSCodium extension installation is prepared but not enabled.
install-vscodium-extensions.sh
install-vscodium-extensions.ps1

# Optional 1Password SSH integration; Windows remains deferred.
{{ if or (not $onePasswordSsh) (not (has .chezmoi.os (list "linux" "darwin"))) -}}
.ssh
.ssh/config
.ssh/github.pub
.ssh/homelab.pub
.config/1Password/**
{{ end -}}

# Git's personal settings remain unmanaged; shared defaults use .config/git/.
.gitconfig
.gitignore

# Placeholder files remain unmanaged until their config slice is implemented.
**/.keep
.local
.local/share
AppData/Local
Documents
{{ if ne .chezmoi.os "darwin" -}}
Library
Library/Application Support
{{ end -}}
.profile
.bash_logout
.config/VSCodium/product.json
.config/VSCodium/User/snippets/**
.config/bash/logout
.config/fastfetch/arch.txt
.config/ghostty/themes/dankcolors
.config/ghostty/themes/noctalia
.config/hypr/**
.config/noctalia/**
.config/vm-curator/**
.config/zed/themes/**
.local/share/applications/**
.local/share/backgrounds/**
.local/share/icons/**
AppData/Local/1Password/**
AppData/Local/nvim/**
AppData/Roaming/VSCodium/product.json
AppData/Roaming/VSCodium/User/snippets/**
AppData/Roaming/Zed/themes/**
AppData/Roaming/topgrade.toml
Documents/PowerShell/**
Library/Application Support/VSCodium/product.json
Library/Application Support/VSCodium/User/snippets/**
