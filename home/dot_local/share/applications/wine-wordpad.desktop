# Keep installed and available to file associations; hide from application menus.
[Desktop Entry]
Name=Wine Wordpad
Comment=Text Editor
Exec=wine wordpad.exe
Icon=wordpad
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=wordpad.exe
Categories=X-Wine;
X-Desktop-File-Install-Version=0.28
NoDisplay=true
TryExec=wine
