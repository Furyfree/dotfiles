# Keep installed and available to file associations; hide from application menus.
[Desktop Entry]
Name=Wine Help
Comment=Windows Help Browser
Exec=wine winhlp32.exe
Icon=winhelp
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=winhlp32.exe
Categories=X-Wine;
X-Desktop-File-Install-Version=0.28
NoDisplay=true
TryExec=wine
