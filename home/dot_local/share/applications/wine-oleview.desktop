# Keep installed and available to file associations; hide from application menus.
[Desktop Entry]
Name=Wine OLE View
Comment=Windows OLE View
Exec=wine oleview.exe
Icon=wine
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=oleview.exe
Categories=X-Wine;
