{{/* chezmoi:modify-template */}}
{{- /* Obsidian rewrites this file from memory, so leave it alone while it runs. */ -}}
{{- if output "sh" "-c" `pgrep -f '(^|/)obsidian( |$)' >/dev/null && echo open || true` | trim -}}
{{-   warnf "Obsidian is open; close it and re-run chezmoi apply to reset the sidebars" -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{- $main := `{
  "id": "a1d4c0ffee000001",
  "type": "split",
  "children": [
    {
      "id": "a1d4c0ffee000002",
      "type": "tabs",
      "children": [
        {
          "id": "a1d4c0ffee000003",
          "type": "leaf",
          "state": {
            "type": "empty",
            "state": {},
            "icon": "lucide-file",
            "title": "New tab"
          }
        }
      ]
    }
  ],
  "direction": "vertical"
}` | fromJson -}}
{{- $left := `{
  "id": "a1d4c0ffee000010",
  "type": "split",
  "children": [
    {
