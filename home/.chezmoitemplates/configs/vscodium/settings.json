{
  "workbench.startupEditor": "newUntitledFile",
  "window.restoreWindows": "none",
  "files.hotExit": "onExitAndWindowClose",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.iconTheme": "material-icon-theme",
{{- if and (eq .chezmoi.os "linux") (has "hyprland-noctalia" (get . "profiles" | default (list))) }}
  "workbench.colorTheme": "NoctaliaTheme",
  "window.autoDetectColorScheme": false,
{{- else }}
  "workbench.colorTheme": "Atom One Dark",
  "workbench.preferredDarkColorTheme": "Atom One Dark",
  "workbench.preferredLightColorTheme": "Atom One Light",
  "window.autoDetectColorScheme": true,
{{- end }}

  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontSize": 15,
  "editor.fontLigatures": false,
  "editor.cursorStyle": "block",
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.renderWhitespace": "selection",
  "editor.inlayHints.enabled": "off",
  "editor.definitionLinkOpensInPeek": false,
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "files.autoSave": "off",
  "prettier.enable": false,
  "[go]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": { "source.organizeImports": "never" }
  },
  "[zig]": { "editor.formatOnSave": false },
  "[python]": { "editor.formatOnType": false },
  "errorLens.enabled": true,
  "errorLens.messageBackgroundMode": "none",

  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontLigatures.enabled": false,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.splitCwd": "workspaceRoot",
  "files.associations": {
    "dot_zshenv": "shellscript",
    "dot_zprofile": "shellscript",
    "dot_zshrc": "shellscript",
    "dot_zlogin": "shellscript",
    "dot_zlogout": "shellscript",
    "*.tmpl": "gotmpl"
  },
  "tinymist.exportPdf": "onSave",
  "tinymist.outputPath": "$dir/$name",

  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": "on",
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "always",
  "security.workspace.trust.untrustedFiles": "newWindow",
  "chat.tools.global.autoApprove": false,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "gitlens.telemetry.enabled": false,
  "python.terminal.activateEnvironment": false
}
