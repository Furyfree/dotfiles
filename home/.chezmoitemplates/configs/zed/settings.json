{{- /* Keep frequently changed model choices local; do not import them into Git. */ -}}
{{- $target := joinPath .chezmoi.homeDir ".config/zed/settings.json" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $target = joinPath .chezmoi.homeDir "AppData/Roaming/Zed/settings.json" -}}
{{- end -}}
{{- $local := dict -}}
{{- if stat $target -}}
{{-   $local = include $target | fromJsonc -}}
{{- end -}}
{{- $localAgent := get $local "agent" | default (dict) -}}
{{- $servers := get $local "agent_servers" | default (dict) -}}
{{- $renderData := dict "chezmoi" .chezmoi "profiles" (get . "profiles" | default (list)) "localAgent" $localAgent "servers" $servers -}}
{{- $rendered := includeTemplate "configs/zed/settings-body.json" $renderData -}}
{{- if and (stat $target) (eq ($local | toJson) ($rendered | fromJson | toJson)) -}}
{{- include $target -}}
{{- else -}}
{{- $rendered -}}
{{- end -}}
