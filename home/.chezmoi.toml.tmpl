{{- $platformProfiles := list -}}
{{- $machineProfiles := list -}}
{{- $onePasswordSsh := false -}}

{{- /*
The Nimbus profile vocabulary, offered by the interactive prompt. Nimbus
supplies the list through --promptMultichoice and it is stored as sent, so a
new Nimbus profile never breaks the handoff. Deferred profiles stay out of
the choices until their configs are maintained: niri-noctalia,
hyprland-dms.
*/ -}}
{{- $machineChoices := list
      "common"
      "development"
      "virtualization"
      "gaming"
      "laptop-gaming"
      "hyprland-noctalia"
      "niri-dms"
      "windows-vm"
-}}
{{- /*
The three Nimbus handoff keys. Direct initialization answers them by hand:
the machine name defaults to the hostname and ManagedByNimbus to false.
*/ -}}
{{- $machine := promptStringOnce . "Machine" "Machine" .chezmoi.hostname -}}
{{- $managedByNimbus := promptBoolOnce . "ManagedByNimbus" "ManagedByNimbus" false -}}
{{- $onePasswordSsh = promptBoolOnce
      . "onePasswordSsh" "Enable 1Password SSH integration" false
-}}

{{- if eq .chezmoi.os "linux" -}}
{{-   $platformProfiles = list "unix" "linux" -}}
{{-   $machineProfiles = promptMultichoiceOnce
        . "Profiles" "Profiles" $machineChoices (list "common")
-}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $platformProfiles = list "unix" "macos" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $platformProfiles = list "windows" -}}
{{- else -}}
{{-   fail (printf "unsupported operating system %q" .chezmoi.os) -}}
{{- end -}}

{{- $profiles := uniq (concat (list "common") $platformProfiles $machineProfiles) -}}

[diff]
exclude = ["scripts"]

[data]
Machine = {{ $machine | quote }}
# Optional account metadata; app passwords remain in the local keyring.
fastmailUsername = {{ get . "fastmailUsername" | default "" | quote }}
ManagedByNimbus = {{ $managedByNimbus }}
onePasswordSsh = {{ $onePasswordSsh }}
Profiles = [
{{- range $machineProfiles }}
  {{ . | quote }},
{{- end }}
]
profiles = [
{{- range $profiles }}
  {{ . | quote }},
{{- end }}
]

{{ if and $onePasswordSsh (has .chezmoi.os (list "linux" "darwin")) -}}
# Let the desktop app authorize op; do not request a CLI session token.
[onepassword]
prompt = false

# Field-only public-key lookups, with Chezmoi's --skip-secrets support.
[secret]
command = "op"
{{ end -}}
