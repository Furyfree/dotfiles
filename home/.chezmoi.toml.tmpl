{{- $platformProfiles := list -}}
{{- $machineProfiles := list -}}
{{- $managedByNimbus := false -}}
{{- $onePasswordSsh := false -}}

{{- $machineChoices := list
      "common"
      "development"
      "gaming"
      "hyprland-noctalia"
      "windows-vm"
-}}
{{- /*
Deferred machine profiles stay out of the choices until their configs are
maintained: niri-noctalia, niri-dms, hyprland-dms.
*/ -}}
{{- $machine := promptStringOnce . "machine" "Machine" .chezmoi.hostname -}}
{{- if eq (trim $machine) "" -}}
{{-   fail "machine must not be empty" -}}
{{- end -}}
{{- $onePasswordSsh = promptBoolOnce
      . "onePasswordSsh" "Enable 1Password SSH integration" false
-}}

{{- if eq .chezmoi.os "linux" -}}
{{-   $platformProfiles = list "unix" "linux" -}}
{{-   $managedByNimbus = promptBoolOnce
        . "managed_by_nimbus" "ManagedByNimbus" false
-}}
{{-   $machineProfiles = promptMultichoiceOnce
        . "Profiles" "Profiles" $machineChoices (list "common")
-}}
{{-   range $profile := $machineProfiles -}}
{{-     if not (has $profile $machineChoices) -}}
{{-       fail (printf "invalid machine profile %q" $profile) -}}
{{-     end -}}
{{-   end -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $platformProfiles = list "unix" "macos" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $platformProfiles = list "windows" -}}
{{- else -}}
{{-   fail (printf "unsupported operating system %q" .chezmoi.os) -}}
{{- end -}}

{{- $profiles := uniq (concat (list "common") $platformProfiles $machineProfiles) -}}

[data]
machine = {{ $machine | quote }}
managed_by_nimbus = {{ $managedByNimbus }}
onePasswordSsh = {{ $onePasswordSsh }}
Profiles = [
{{- range $machineProfiles }}
  {{ . | quote }},
{{- end }}
]
profiles = [
{{- range $profiles }}
  {{ . | quote }},
{{- end }}
]
