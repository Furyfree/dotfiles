{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# Refresh only the user's cache; application packages own linked images.
command -v gtk-update-icon-cache >/dev/null 2>&1 || exit 0
theme="$HOME/.local/share/icons/hicolor"
[ -f "$theme/index.theme" ] || exit 0
for icon in "$theme"/*/apps/*; do
    [ -f "$icon" ] || continue
    gtk-update-icon-cache --quiet --force --index-only "$theme"
    exit 0
done
{{- end }}
