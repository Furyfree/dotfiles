#!/bin/sh
# Build $1/Projects with one repository per pull-projects case, sharing one remote.
set -eu
home=$1
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.invalid
export GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.invalid

commit() { printf '%s\n' "$2" > "$1/$2"; git -C "$1" add "$2"; git -C "$1" commit -q -m "$2"; }

git init -q --bare -b main "$home/remote.git"
git clone -q "$home/remote.git" "$home/seed" 2>/dev/null
commit "$home/seed" first
git -C "$home/seed" push -q origin main
mkdir -p "$home/Projects/not-a-repo"
for name in behind dirty diverged; do
  git clone -q "$home/remote.git" "$home/Projects/$name"
done
git init -q -b main "$home/Projects/no-upstream"
commit "$home/Projects/no-upstream" local
commit "$home/seed" second
git -C "$home/seed" push -q origin main
git clone -q "$home/remote.git" "$home/Projects/current"
printf 'draft\n' > "$home/Projects/dirty/untracked"
commit "$home/Projects/diverged" local
